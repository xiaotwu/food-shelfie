    "settings.reminderScheduleFootnote": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Dated foods receive a warning and an expiry reminder at your selected local time. There are no daily check-in reminders for an empty shelf. Weekly summaries are scheduled only around dated foods."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有日期的食品会在所选本地时间收到临期提醒和到期提醒。空库存不会收到每日检查提醒。周报仅在有日期食品的相关时间安排。"
          }
        }
      }
    },
    "settings.remindersInactive": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders are inactive. Enable reminders and allow system notifications to schedule them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒尚未启用。请开启提醒并允许系统通知后安排提醒。"
          }
        }
      }
    },
    "settings.reminderCoverage": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Planned: %d requests covering %d of %d dated batches. Shelfie keeps at most 60 requests, prioritizing the earliest dates. Reopen Shelfie after handling foods to refresh coverage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已计划 %d 条通知，覆盖 %d / %d 批有日期食品。Shelfie 最多保留 60 条通知，优先安排较近日期。处理食品后重新打开应用可更新覆盖范围。"
          }
        }
      }
    },
