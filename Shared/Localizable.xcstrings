    "about.privacyRow": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored on your device by default. Optional iCloud sync uses your Apple account. Barcode lookup sends the barcode to Open Food Facts and downloads product photos. No ads or tracking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认保存在设备上。可选 iCloud 同步使用你的 Apple 账户。条码查询会将条码发送至 Open Food Facts 并下载商品照片。无广告或追踪。"
          }
        }
      }
    },
