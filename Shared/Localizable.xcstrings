    "settings.privacyBody": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Inventory and photos stay on your device unless you enable iCloud sync. Barcode lookup sends barcodes to Open Food Facts; product images are downloaded from its image provider. Camera and photo OCR run on device. No ads, analytics, or tracking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "库存与照片默认保存在设备上，启用 iCloud 后通过 Apple 账户同步。条码会发送至 Open Food Facts，商品图片从其图片服务下载。相机与照片文字识别在设备上运行。无广告、分析或追踪。"
          }
        }
      }
    },
